PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app
FARM_PASSWORD=change-this-owner-password
FARM_SESSION_SECRET=generate-a-long-random-secret
MAX_ACTIVE=3
SCREENSHOT_INTERVAL=800
ENABLE_BROWSER_EVAL=false
# Optional local Chromium path; omit on Render to use bundled Chromium.
# PUPPETEER_EXEC=/usr/bin/google-chrome-stable
