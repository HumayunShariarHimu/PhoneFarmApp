# ── Database ───────────────────────────────────
DATABASE_URL=postgresql://pfarm:password@localhost:5432/phonefarm

# ── Redis ──────────────────────────────────────
REDIS_URL=redis://:password@localhost:6379

# ── Server ─────────────────────────────────────
PORT=4000
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app

# ── Auth ───────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_in_production
ADMIN_EMAIL=admin@phonefarm.io
ADMIN_PASSWORD=change_this_password

# ── Android Emulation ──────────────────────────
ANDROID_IMAGES_PATH=/android/images
ANDROID_BASE_IMG=/android/base/android-x86-9.0-r2.iso
ADB_PATH=/usr/bin/adb
QEMU_PATH=/usr/bin/qemu-system-x86_64
MAX_EMULATORS=50
WORKER_CONCURRENCY=5
AUTO_RESTART=true

# ── Puppeteer ──────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

# ── Cloud Emulation (alternatives) ─────────────
APPETIZE_API_KEY=
GENYMOTION_API_KEY=
